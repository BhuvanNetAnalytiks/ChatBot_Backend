{
  "steps": [
    {
      "function": "create_jwt_token",
      "module": "main_library.jwt_auth",
      "endpoint": "/create_jwt_token",
      "methods": [
        "POST"
      ],
      "parameters": [
        {
          "name": "user_id",
          "type": "body"
        },
        {
          "name": "email",
          "type": "body"
        },
        {
          "name": "display_name",
          "type": "body"
        }
      ]
    },
    {
      "function": "create_refresh_token",
      "module": "main_library.jwt_auth",
      "endpoint": "/create_refresh_token",
      "methods": [
        "POST"
      ],
      "parameters": [
        {
          "name": "user_id",
          "type": "body"
        }
      ]
    },
    {
      "function": "verify_jwt_token",
      "module": "main_library.jwt_auth",
      "endpoint": "/verify_jwt_token",
      "methods": [
        "POST"
      ],
      "parameters": [
        {
          "name": "token",
          "type": "body"
        }
      ]
    },
    {
      "function": "verify_refresh_token",
      "module": "main_library.jwt_auth",
      "endpoint": "/verify_refresh_token",
      "methods": [
        "POST"
      ],
      "parameters": [
        {
          "name": "token",
          "type": "body"
        }
      ]
    },
    {
      "function": "set_auth_cookie",
      "module": "main_library.jwt_auth",
      "endpoint": "/set_auth_cookie",
      "methods": [
        "POST"
      ],
      "parameters": [
        {
          "name": "jwt_token",
          "type": "body"
        },
        {
          "name": "refresh_token",
          "type": "body"
        }
      ]
    },
    {
      "function": "clear_auth_cookie",
      "module": "main_library.jwt_auth",
      "endpoint": "/clear_auth_cookie",
      "methods": [
        "POST"
      ]
    }
  ]
}
